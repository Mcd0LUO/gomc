# case: execute and selectors
step 1: summon armor_stand 10 20 30
  count: 1
  feedback: Summoned new armor_stand at 10.00, 20.00, 30.00
step 2: summon zombie 0 0 0
  count: 1
  feedback: Summoned new zombie at 0.00, 0.00, 0.00
step 3: execute @e[type=armor_stand] ~ ~1 ~ setblock ~ ~ ~ stone
  count: 1
step 4: scoreboard players tag @e[type=zombie] add marked
  count: 1
  feedback: Successfully added tag marked
step 5: scoreboard players tag @e[tag=marked] list
  count: 1
  feedback: Tags for entity-2: marked
step 6: execute @e[type=zombie] ~ ~ ~ detect ~ ~-1 ~ air 0 say ground is clear
  count: 1
  feedback: [Zombie] ground is clear
step 7: say done
  count: 1
  feedback: [Server] done
