name: rpg:attribute/hp/restore

setup:
  scoreboard objectives add health dummy
  scoreboard objectives add health.max dummy
  scoreboard objectives add health.restore dummy
  gomcplayer Steve 0 4 0
  scoreboard players set Steve health 10
  scoreboard players set Steve health.max 20
  scoreboard players set Steve health.restore 5

run:
  execute Steve ~ ~ ~ function rpg:attribute/hp/restore
