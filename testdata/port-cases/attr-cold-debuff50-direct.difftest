name: rpg:attribute/cold/debuff_50 called DIRECTLY

setup:
  scoreboard objectives add bar.cold dummy
  scoreboard objectives add bar.cold.max dummy
  scoreboard objectives add health dummy
  scoreboard objectives add num dummy
  scoreboard players set 0 num 0
  gomcplayer Steve 0 4 0
  scoreboard players set Steve bar.cold 50
  scoreboard players set Steve bar.cold.max 50
  scoreboard players set Steve health 20

run:
  execute Steve ~ ~ ~ function rpg:attribute/cold/debuff_50
